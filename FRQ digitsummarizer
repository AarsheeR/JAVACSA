package javaPack;

public class DigitSummarizer {
	/** Returns the single-digit "digital root" of n
	* Precondition: n is a positive number
	*/
	public int digitalRoot(int n)
	{
		if (n < 10 ) {
			return n;
		}
		else {
			while (n >= 10) {
				n = digitSum(n);
			}
			return n;
		}

	}
	/** Returns true if one of the digits of n is equal
	* to the digital root of n.
	* Precondition: n is a positive number
	*/
	public boolean containsRoot(int n)
	{
		int digiroot = digitalRoot(n);
		
		while (n>0) {
			if ((n%10) == digiroot) {
				return true;
			}
			else {
				n = n/10;
			}
		}
		return false;

	}
	/** Returns the sum of the digits in n
	* Precondition: n is a positive number
	*/
	public int digitSum(int n)
	{
		int sum = 0;
		
		if (n < 10 ) {
			return n;
		}
		else {
			while (n>0) {
				int digitsum = (n%10);
				sum = sum + digitsum;
				n = n/10;
				
			}
			return sum;
		}
	}
}
